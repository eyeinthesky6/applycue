{
  "name": "applycue",
  "version": "0.1.0",
  "description": "ApplyCue: an agent-led CV-to-offer pipeline.",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "applycue:build": "tsc -b",
    "applycue:check": "pnpm applycue:typecheck && pnpm applycue:test",
    "applycue:approve-answers": "pnpm applycue:build && node apps/worker/dist/index.js approve-answers",
    "applycue:approve-sources": "pnpm applycue:build && node apps/worker/dist/index.js approve-sources",
    "applycue:apply-route": "pnpm applycue:build && node apps/worker/dist/index.js apply-route",
    "applycue:apply-tuning": "pnpm applycue:build && node apps/worker/dist/index.js apply-tuning",
    "applycue:browser-live-apply": "pnpm applycue:build && node apps/worker/dist/index.js browser-live-apply",
    "applycue:browser-live-preflight": "pnpm applycue:build && node apps/worker/dist/index.js browser-live-preflight",
    "applycue:browser-preflight": "pnpm applycue:build && node apps/worker/dist/index.js browser-preflight",
    "applycue:browser-uat": "pnpm applycue:build && node apps/worker/dist/index.js browser-uat",
    "applycue:first-build": "pnpm applycue:build && node apps/worker/dist/index.js first-build",
    "applycue:form-data": "pnpm applycue:build && node apps/worker/dist/index.js form-data",
    "applycue:import-email-leads": "pnpm applycue:build && node apps/worker/dist/index.js import-email-leads",
    "applycue:record-outcome": "pnpm applycue:build && node apps/worker/dist/index.js record-outcome",
    "applycue:record-decision": "pnpm applycue:build && node apps/worker/dist/index.js record-decision",
    "applycue:record-decisions": "pnpm applycue:build && node apps/worker/dist/index.js record-decisions",
    "applycue:record-tuning": "pnpm applycue:build && node apps/worker/dist/index.js record-tuning",
    "applycue:scan-email-leads": "pnpm applycue:build && node apps/worker/dist/index.js scan-email-leads",
    "applycue:setup": "pnpm applycue:build && node apps/worker/dist/index.js setup",
    "applycue:source-canary": "pnpm applycue:build && node apps/worker/dist/index.js source-canary",
    "applycue:status": "pnpm applycue:build && node apps/worker/dist/index.js status",
    "applycue:typecheck": "tsc -b",
    "applycue:test": "vitest run --passWithNoTests",
    "applycue:uat": "pnpm applycue:build && node apps/worker/dist/index.js uat",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium --with-deps"
  },
  "keywords": [
    "applycue",
    "ai",
    "job-search",
    "cv-to-offer",
    "claude-code",
    "opencode",
    "career",
    "automation"
  ],
  "author": "ApplyCue contributors",
  "homepage": "https://github.com/eyeinthesky6/applycue",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyeinthesky6/applycue"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
